# --- setpoint runtime output ---
# Calibration profiles are keyed by a hardware and model signature, so they are
# meaningless on another machine. Sharing happens through `setpoint profile export`.
profiles/
*.setpoint.yaml

# Raw measurement traces from tune and bench runs.
runs/
*.trace.json
bench-*.json

# Models are large binaries and never belong in the repo.
models/
*.gguf
*.bin
*.safetensors

